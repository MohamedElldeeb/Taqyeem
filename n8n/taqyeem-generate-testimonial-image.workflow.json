    {
      "id": "n-build-email-html",
      "name": "Build Email HTML",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1280,
        -480
      ],
      "parameters": {
        "jsCode": "const d = $input.item.json;\nconst complete = $('Complete Generation').item.json;\nconst reviewId = $('Extract Image').item.json.review_id;\nconst email = d.email;\n\nconst ratingStars = '★'.repeat(email.rating) + '☆'.repeat(5 - email.rating);\nconst customerLine = email.customer_name ? email.customer_name : 'عميل';\n\nconst html = `\n<div dir=\"rtl\" style=\"font-family: Tahoma, Arial, sans-serif; max-width: 480px; margin: 0 auto; color: #171717;\">\n  <p style=\"font-size: 16px;\">مرحبًا ${email.business_name}،</p>\n  <p style=\"font-size: 15px;\">وصلك تقييم جديد من عميلك، وتصميم التقييم الجاهز للمشاركة أصبح متاحًا الآن.</p>\n  <p style=\"font-size: 14px; margin-bottom: 4px;\"><strong>الاسم:</strong> ${customerLine}</p>\n  <p style=\"font-size: 14px; margin-bottom: 4px;\"><strong>التقييم:</strong> ${ratingStars} (${email.rating}/5)</p>\n  <blockquote style=\"font-size: 15px; border-right: 3px solid #087F5B; padding-right: 12px; margin: 16px 0; color: #171717;\">${email.original_text}</blockquote>\n  <img src=\"${complete.image_url}\" alt=\"تصميم التقييم\" style=\"width: 100%; max-width: 480px; border-radius: 8px; display: block; margin: 16px 0;\" />\n  <p style=\"font-size: 13px; color: #737373;\">مدعوم من تقييم</p>\n</div>\n`;\n\nreturn {\n  json: {\n    review_id: reviewId,\n    to: email.to,\n    subject: 'تقييم جديد جاهز للمشاركة ✨',\n    html\n  }\n};"
      }
