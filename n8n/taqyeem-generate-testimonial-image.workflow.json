    {
      "id": "n-build-prompt",
      "name": "Build Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -400,
        -240
      ],
      "parameters": {
        "jsCode": "const d = $input.item.json;\nconst brandColor = d.merchant.brand_color;\n\nconst prompt = \"This image is a BACKGROUND TEMPLATE for a social-media testimonial card. It will have real text added on top afterward by a separate deterministic process \\u2014 you must NOT render any text, letters, numbers, words, logos, stars, or typography of any kind in this image.\\n\\n\" +\n\"Use the attached reference image as the primary art-direction source. Study its composition, spatial hierarchy, dark cinematic mood, grid/texture language, contrast, glow/bloom behavior, visual density, negative space and depth \\u2014 then create a NEW composition in that same visual language. Do not copy the reference pixel-for-pixel or reproduce its exact content; interpret its art direction for a new, original composition.\\n\\n\" +\n\"Composition requirements:\\n\" +\n\"- Exactly 1:1 square, full-bleed, high resolution.\\n\" +\n\"- Reserve a clear, intentional text-safe area covering roughly the right two-thirds of the frame vertically from about 25% to 90% of the height. This area must have lower visual detail/contrast so large white text reads clearly when placed on top afterward. Do not place bright highlights, sharp edges, or busy detail directly in this zone.\\n\" +\n\"- Use exactly this hex color as a deliberate accent (in glow, gradient, or edge lighting) \\u2014 never recolor the whole image with it, use it as a controlled accent only: \" + brandColor + \".\\n\" +\n\"- Build genuine depth and texture: layered lighting, glow blooms, a fine grid or line-based graphic language, controlled contrast \\u2014 the composition should feel deliberate and premium, not like an empty gradient.\\n\\n\" +\n\"Absolutely forbidden in this image:\\n\" +\n\"- any text, words, letters, or numbers\\n\" +\n\"- any logo or brand mark\\n\" +\n\"- any star icons or rating indicators\\n\" +\n\"- any typography or lettering of any kind, real or decorative-looking\\n\" +\n\"- people, hands, phones, or photographic elements\\n\\n\" +\n\"This is purely a visual background template \\u2014 all customer text, name, rating, and merchant identity will be added afterward by the application, not by you.\";\n\nreturn {\n  json: {\n    prompt,\n    referenceImageBase64: d.referenceImageBase64,\n    referenceMime: d.referenceMime,\n    review_id: d.review.id,\n    merchant_id: d.merchant.id,\n    generated_content_id: d.generated_content_id\n  }\n};"
      }
    },
